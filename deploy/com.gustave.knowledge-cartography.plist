<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly launchd job for knowledge-cartography, running on
  gustaves-mac-mini. Paths assume the repo is cloned to
  ~/code/knowledge-cartography under the gustavevernay account — see
  docs/MACMINI_SETUP.md for a from-scratch install on a different account.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gustave.knowledge-cartography</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/gustavevernay/code/knowledge-cartography/scripts/process_inbox.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/gustavevernay/code/knowledge-cartography</string>

    <!-- Nightly at 03:00, per docs/ARCHITECTURE.md's "planning nocturne". -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/gustavevernay/Library/Logs/cartography/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gustavevernay/Library/Logs/cartography/launchd.err.log</string>

    <!-- Don't run immediately on every load/login — only on schedule. -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
