<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly launchd job for knowledge-cartography, meant to run on the Mac
  Mini. Install per docs/MACMINI_SETUP.md.

  BEFORE INSTALLING: replace every /Users/gustave/code/knowledge-cartography
  below with the actual path where you cloned this repo on the Mac Mini,
  and /Users/gustave with that account's actual home directory.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gustave.knowledge-cartography</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/gustave/code/knowledge-cartography/scripts/process_inbox.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/gustave/code/knowledge-cartography</string>

    <!-- Nightly at 03:00, per docs/ARCHITECTURE.md's "planning nocturne". -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/gustave/Library/Logs/cartography/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gustave/Library/Logs/cartography/launchd.err.log</string>

    <!-- Don't run immediately on every load/login — only on schedule. -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
